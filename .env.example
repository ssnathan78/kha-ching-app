# Copy to .env and fill Kite keys. Never commit .env.

# --- Docker Compose (app + Postgres + Redis) ---
# Inside the app container, compose overrides DATABASE_URL/REDIS_URL to use
# hostnames `postgres` and `redis`. Values below are for running the app on the host.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_db
REDIS_URL=redis://127.0.0.1:6379

# --- Kite Connect ---
# Zerodha allows ONE redirect URL per app.
# Production HTTPS: https://YOUR_HOST/api/redirect_url_kite
# Local Docker:     http://127.0.0.1:3000/api/redirect_url_kite
#
# Never commit a real production hostname or IP. Put that only in the server .env.
# Use a separate Kite Connect "dev" app for localhost, or temporarily change the
# production app's redirect URL while testing (that will break droplet login).
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

NODE_ENV=development
PORT=3000
TZ=Asia/Kolkata
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_DEFAULT_LOTS=2
NEXT_PUBLIC_DEFAULT_SKEW_PERCENT=10
NEXT_PUBLIC_DEFAULT_SQUARE_OFF_TIME=15:20
NEXT_PUBLIC_DEFAULT_SLM_PERCENT=30

# Must be 32+ characters
SECRET_COOKIE_PASSWORD=your_secure_cookie_password_min_32_chars

# Local Docker / HTTP: keep false so the login cookie is stored on http://127.0.0.1
# Production HTTPS: set true (or omit; HTTPS URLs default to Secure cookies)
SESSION_COOKIE_SECURE=false

# true = talk to Kite for login/LTP/instruments, but do not place real orders
MOCK_ORDERS=true

# Optional logs
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
