{
  "name": "kha-ching",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require ./otel.js server.js",
    "build": "next build",
    "migrate": "node scripts/migrate.mjs",
    "start": "node --require ./otel.js server.js",
    "healthcheck": "node ./bootup.js",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "test": "yarn unit-test && yarn sim-test && yarn int-test && yarn api-test",
    "unit-test": "jest ./__tests__/unit --setupFiles ./__tests__/loadEnv.js --setupFiles ./__tests__/unitMocks.js --detectOpenHandles --forceExit",
    "sim-test": "jest ./__tests__/simulation --setupFiles ./__tests__/loadEnv.js --setupFiles ./__tests__/simulation/setup.js --setupFilesAfterEnv ./__tests__/simulation/jest.after.js --detectOpenHandles --forceExit",
    "simulate": "node scripts/simulate.mjs",
    "int-test": "jest ./__tests__/integration --runInBand --forceExit",
    "api-test": "jest ./__tests__/api --setupFiles ./__tests__/loadEnv.js --setupFiles ./__tests__/apiMocks.js --runInBand --forceExit",
    "e2e-test": "playwright test",
    "test:coverage": "jest ./__tests__/unit ./__tests__/integration ./__tests__/api --setupFiles ./__tests__/loadEnv.js --setupFiles ./__tests__/unitMocks.js --setupFiles ./__tests__/apiMocks.js --coverage --coverageReporters=text-summary --forceExit",
    "live-test": "jest ./__tests__/live --runInBand --forceExit",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push",
    "queues": "node scripts/bull-board.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@bull-board/api": "^9.8.0",
    "@bull-board/express": "^9.8.0",
    "@bull-board/ui": "^9.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/winston-transport": "^0.32.0",
    "@types/styled-jsx": "^3.4.4",
    "axios": "^1.20.0",
    "bullmq": "^6.3.4",
    "dayjs": "^1.10.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "iron-session": "^9.0.1",
    "kiteconnect": "5.3.0",
    "memoizee": "^0.4.15",
    "nanoid": "^6.0.1",
    "next": "^16.2.1",
    "pg": "^8.11.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-jsx": "^5.1.7",
    "swr": "^2.2.0",
    "winston": "^3.7.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.27.1",
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7",
    "@types/node": "25.6.0",
    "@types/prop-types": "^15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "babel-jest": "^30.5.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "node-mocks-http": "^1.18.1",
    "prop-types": "^15.8.1",
    "react-test-renderer": "^19.2.8",
    "typescript": "^5.8.3"
  },
  "cacheDirectories": [
    ".next/cache"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "yarn@4.9.1"
}
